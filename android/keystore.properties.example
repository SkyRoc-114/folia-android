# 当前文件：本地 Android 发布签名配置示例；复制为 keystore.properties 后填写真实值。
#
# 仓库已入库一份稳定 keystore（android/app/folia-release.p12 + android/keystore.properties），
# CI 与本地构建默认就用它——只有想换私有密钥时才需要覆盖这份文件（换密钥=老用户全部卸载重装，慎重）。
#
# storeFile 相对 android/app/ 解析；PKCS12 必须写 storeType=PKCS12（JKS 可省略或写 JKS）。
storeFile=folia-release.p12
storePassword=change-me
keyAlias=folia
keyPassword=change-me
storeType=PKCS12
